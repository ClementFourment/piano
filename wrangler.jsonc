{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piano",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Toutes les URL inconnues renvoient index.html (appli React), sauf /api/* qui passe par le Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piano",
      "database_id": "a035aa7f-e8e8-4c5a-961a-369de2db3e64",
      "migrations_dir": "migrations"
    }
  ],
  // Adresse de test tant que piano.clementfourment.fr sert encore l'ancien éditeur.
  "workers_dev": true,
  "observability": { "enabled": true }
}
